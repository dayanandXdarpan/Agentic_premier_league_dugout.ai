# Backend Environment Variables

# Port configuration (Cloud Run provides this automatically as $PORT)
PORT=8080

# ============================================
# GEMINI AI CONFIGURATION (Choose ONE method)
# ============================================

# Method 1: Google AI Studio API Key (Easiest - get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Method 2: Google Cloud Vertex AI (requires GCP project with Vertex AI API enabled)
# GCP_PROJECT_ID=your-project-id
# GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# If NEITHER is set, the app runs in MOCK mode (no AI calls, uses sample data)

# ============================================
# SCRAPER CONFIGURATION
# ============================================
MATCH_URL=https://www.cricbuzz.com/cricket-match-highlights/89753/kkr-vs-srh-final-indian-premier-league-2024
SCRAPE_INTERVAL=5
LOOP_SIMULATION=false
